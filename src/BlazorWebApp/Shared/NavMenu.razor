@* Sidebar navigation. Each sample gets its own page so the pages stay readable. *@

<div class="sidebar-brand">
    <span class="brand-mark">CF</span>
    <div>
        <div class="brand-title">Workers .NET</div>
        <div class="brand-sub">C# samples on Cloudflare</div>
    </div>
</div>

<nav class="nav">
    @foreach (var group in Groups)
    {
        <div class="nav-group">
            <div class="nav-group-title">@group.Title</div>
            @foreach (var item in group.Items)
            {
                <NavLink class="nav-link" href="@item.Href" Match="@item.Match" title="@item.Description">
                    <span class="nav-icon">@item.Icon</span>
                    <span class="nav-label">@item.Label</span>
                </NavLink>
            }
        </div>
    }

    <AuthorizeView Context="navAuth">
        <Authorized>
            <div class="nav-group">
                <div class="nav-group-title">Account</div>
                <NavLink class="nav-link" href="account" Match="NavLinkMatch.All" title="Your profile and sign out">
                    <span class="nav-icon">👤</span>
                    <span class="nav-label">@DisplayName(navAuth.User)</span>
                </NavLink>
                <AuthorizeView Roles="@SampleConfig.AuthAdminRole" Context="adminNav">
                    <NavLink class="nav-link" href="admin" title="Assign roles to users">
                        <span class="nav-icon">🛡️</span>
                        <span class="nav-label">Admin</span>
                    </NavLink>
                </AuthorizeView>
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="nav-group">
                <div class="nav-group-title">Account</div>
                <NavLink class="nav-link" href="login" Match="NavLinkMatch.All" title="Sign in or register">
                    <span class="nav-icon">🔑</span>
                    <span class="nav-label">Sign in</span>
                </NavLink>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</nav>

@code {
    sealed record NavItem(string Href, string Label, string Icon, string Description, NavLinkMatch Match = NavLinkMatch.Prefix);

    sealed record NavGroup(string Title, IReadOnlyList<NavItem> Items);

    static string DisplayName(System.Security.Claims.ClaimsPrincipal user)
        => string.IsNullOrWhiteSpace(user.Identity?.Name) ? "Account" : user.Identity!.Name!;

    static readonly NavGroup[] Groups =
    [
        new NavGroup("Start",
        [
            new NavItem("", "Overview", "🏠", "What these samples are and how to run them", NavLinkMatch.All),
            new NavItem("basics", "Request basics", "🧭", "JSON, proxy fetch, redirect and request validation")
        ]),
        new NavGroup("Bindings",
        [
            new NavItem("cache", "Cache API", "⚡", "caches.default: hit/miss and purge"),
            new NavItem("kv", "KV", "🗄️", "dotnet_test namespace, 3 fixed keys, 64 characters max"),
            new NavItem("r2", "R2 bucket", "📦", "dotnettest bucket, sample_file.txt, 1 KB max")
        ]),
        new NavGroup("Async work",
        [
            new NavItem("queue", "Queue", "📨", "dotnet-queue producer and consumer"),
            new NavItem("scheduled", "Scheduled task", "⏰", "Hourly cron writing to KV")
        ]),
        new NavGroup("Data",
        [
            new NavItem("d1", "D1 database", "🗃️", "items table with create, edit and delete"),
            new NavItem("telemetry", "Weather sensors", "📡", "cron to D1 to queue to rate gate to API")
        ])
    ];
}
