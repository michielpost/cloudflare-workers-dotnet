@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IWebAssemblyHostEnvironment HostEnvironment

<div class="app-shell">
    <aside class="sidebar">
        <NavMenu />
        @if (HostEnvironment.Environment == "Development")
        {
            <div class="sidebar-foot">
                <div class="sidebar-foot-title">Local dev</div>
                <div class="sidebar-foot-body">
                    Aspire starts this frontend plus Wrangler on port 8787. KV, R2 and queues
                    run against local storage under <code>.wrangler/state</code>.
                </div>
            </div>
        }
        <a class="sidebar-github" href="@GitHubUrl" target="_blank" rel="noopener noreferrer" title="View source on GitHub">
            <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
            </svg>
            <span>GitHub</span>
        </a>
    </aside>

    <main class="content">
        <header class="topbar">
            <div class="topbar-crumbs">
                <span class="crumb-root">Cloudflare Workers .NET</span>
                <span class="crumb-sep">/</span>
                <span class="crumb-page">@PageName</span>
            </div>
            <div class="topbar-right">
                <WorkerStatus />
            </div>
        </header>

        <article class="page">
            <ErrorBoundary>
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <Notice Kind="err" Message="This page hit an unhandled error. Reload the page to continue." />
                </ErrorContent>
            </ErrorBoundary>
        </article>
    </main>
</div>

@code {
    const string GitHubUrl = "https://github.com/michielpost/cloudflare-workers-dotnet";

    string PageName => Navigation.Uri.Split('/').LastOrDefault() switch
    {
        "" or null => "overview",
        "basics" => "request basics",
        "cache" => "cache api",
        "kv" => "kv storage",
        "r2" => "r2 bucket",
        "queue" => "queues",
        "scheduled" => "scheduled task",
        "d1" => "d1 database",
        "telemetry" => "weather sensors",
        var other => other
    };
}