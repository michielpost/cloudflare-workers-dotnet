@page "/"
@inject HttpClient Http
@inject IConfiguration Config
@using global::Shared

<PageTitle>Cloudflare Workers .NET Samples</PageTitle>

<div style="font-family:sans-serif; max-width:720px; margin:0 auto; padding:1rem;">
    <h1>Cloudflare Workers .NET Samples</h1>
    <p>
        These samples run server-side in the Cloudflare Worker (<code>Worker.cs</code>) and are called from
        this Blazor WebAssembly frontend. Responses use the shared <code>ApiResponse</code> model from
        <code>src/Shared</code>.
    </p>

    <section style="margin-top:1.5rem;">
        <h2>JSON response</h2>
        <p>Returns an <code>ApiResponse</code> model serialized by the worker.</p>
        <button class="btn" @onclick="CallJson" disabled="@busy">Call /api/json</button>
        <pre class="result">@jsonResult</pre>
    </section>

    <section style="margin-top:1.5rem;">
        <h2>Proxy fetch</h2>
        <p>Worker fetches a remote URL and tags it with <code>x-proxied-by: Workers</code>.</p>
        <input @bind="proxyUrl" style="width:60%" />
        <button class="btn" @onclick="CallProxy" disabled="@busy">Proxy</button>
        <pre class="result">@proxyResult</pre>
    </section>

    <section style="margin-top:1.5rem;">
        <h2>Redirect</h2>
        <p>Worker issues a 302 redirect to the given URL.</p>
        <input @bind="redirectUrl" style="width:60%" />
        <button class="btn" @onclick="CallRedirect" disabled="@busy">Redirect</button>
        <pre class="result">@redirectResult</pre>
    </section>

    <section style="margin-top:1.5rem;">
        <h2>Request policy</h2>
        <p>
            Worker only accepts a bounded JSON POST and validates the payload. The request is sent from the
            browser, so cross-origin <code>fetch</code> to the worker requires CORS.
        </p>
        <button class="btn" @onclick="CallPolicyValid" disabled="@busy">Send valid reading</button>
        <button class="btn" @onclick="CallPolicyInvalid" disabled="@busy">Send invalid reading</button>
        <pre class="result">@policyResult</pre>
    </section>
</div>

@code {
    // Base URL for the worker API. Configured via wwwroot/appsettings.json
    // ("" = same domain as the deployed Blazor site) or
    // wwwroot/appsettings.Development.json (separate local dev port).
    private string ApiBase => (Config["ApiBaseUrl"] ?? "").TrimEnd('/');

    private bool busy;
    private string jsonResult = "";
    private string proxyResult = "";
    private string redirectResult = "";
    private string policyResult = "";

    private string proxyUrl = "https://example.com";
    private string redirectUrl = "https://example.com";

    private async Task CallJson()
    {
        await RunAsync(async () =>
        {
            var r = await Http.GetFromJsonAsync<ApiResponse>(ApiBase + "/api/json");
            jsonResult = r is null
                ? "No response"
                : $"ok={r.Ok} message=\"{r.Message}\" path=\"{r.Path}\" at={r.Timestamp:O}";
        });
    }

    private async Task CallProxy()
    {
        await RunAsync(async () =>
        {
            var resp = await Http.GetAsync(ApiBase + "/api/proxy?url=" + Uri.EscapeDataString(proxyUrl));
            var body = await resp.Content.ReadAsStringAsync();
            var proxiedBy = resp.Headers.TryGetValues("x-proxied-by", out var v) ? string.Join(",", v) : "n/a";
            proxyResult = "status=" + (int)resp.StatusCode + " " + resp.StatusCode + "\n" +
                          "x-proxied-by=" + proxiedBy + "\n\n" + body;
        });
    }

    private async Task CallRedirect()
    {
        await RunAsync(async () =>
        {
            // Fetch the redirect without auto-following so we can read the Location header.
            var resp = await Http.GetAsync(ApiBase + "/api/redirect?to=" + Uri.EscapeDataString(redirectUrl), HttpCompletionOption.ResponseHeadersRead);
            redirectResult = $"status={(int)resp.StatusCode} {resp.StatusCode}\nlocation={resp.Headers.Location}";
        });
    }

    private async Task CallPolicyValid() => await CallPolicy(new ReadingInput("sensor-01", 42.5, new[] { "temp", "indoor" }));

    private async Task CallPolicyInvalid() => await CallPolicy(new ReadingInput("!!bad!!", 99999, new[] { "ok" }));

    private async Task CallPolicy(ReadingInput input)
    {
        await RunAsync(async () =>
        {
            var resp = await Http.PostAsJsonAsync(ApiBase + "/api/policy", input);
            var body = await resp.Content.ReadAsStringAsync();
            policyResult = $"status={(int)resp.StatusCode} {resp.StatusCode}\n{body}";
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        busy = true;
        try { await action(); }
        catch (Exception ex) { policyResult = $"ERROR: {ex.Message}"; }
        finally { busy = false; }
    }
}
